{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':disableDependencyDashboard'
  ],
  automerge: true,
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: ['/(^|/)compile-pdf\\.sh$/', '/(^|/)(release|update)-cvs\\.yml$/'],
      matchStrings: ['(?<depName>ghcr\\.io/xu-cheng/texlive-alpine):(?<currentValue>\\d+)'],
      datasourceTemplate: 'docker',
    },
  ],
}
