{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':disableDependencyDashboard'
  ],
  automerge: true,
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: ['/(^|/)compile-pdf\\.sh$/'],
      matchStrings: ['image=(?<depName>[^:\\s]+):(?<currentValue>\\S+)'],
      datasourceTemplate: 'docker',
    },
  ],
}
