{
  "name": "schultedev",
  "version": "0.0.1",
  "description": "AI-powered Markus Schulte Dev CV generation and transformation scripts",
  "type": "module",
  "scripts": {
    "test": "node --test \"__tests__/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"__tests__/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results.xml --test-reporter=lcov --test-reporter-destination=lcov.info \"__tests__/*.test.ts\"",
    "typecheck": "tsc",
    "clean": "rm -rf node_modules/ tmp/ lcov.info test-results.xml",
    "cv:update": "node cv-update.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SchulteDev/SchulteDev.git"
  },
  "keywords": [
    "cv",
    "resume",
    "ai",
    "claude",
    "automation",
    "cloud-architect",
    "devops"
  ],
  "author": {
    "name": "Markus Schulte",
    "email": "mail@schulte-development.de"
  },
  "license": "EUPL-1.2",
  "bugs": {
    "url": "https://github.com/SchulteDev/SchulteDev/issues"
  },
  "homepage": "https://github.com/SchulteDev/SchulteDev",
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "consola": "3.4.2",
    "dotenv": "18.0.10",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.0.0"
  }
}
