require 'html-proofer'
require 'json'
require 'nokogiri'

# Absolute or protocol-relative URL, i.e. one that leaves this origin.
EXTERNAL = %r{\A(?:https?:)?//}.freeze

# Rels that fetch on page load; canonical/alternate are absolute metadata, not fetches.
FETCHING_LINK_RELS = %w[
  stylesheet preload modulepreload prefetch prerender preconnect dns-prefetch
  icon shortcut apple-touch-icon apple-touch-icon-precomposed mask-icon manifest
].freeze

# Attributes that fetch on page load; <a href> only discloses on click.
SUBRESOURCE_ATTRS = {
  'script' => %w[src], 'img' => %w[src srcset], 'source' => %w[src srcset],
  'iframe' => %w[src], 'embed' => %w[src], 'object' => %w[data],
  'video' => %w[src poster], 'audio' => %w[src], 'track' => %w[src],
  'input' => %w[src]
}.freeze

CSS_REF = %r{(?:url\(\s*['"]?|@import\s+(?:url\(\s*)?['"])((?:https?:)?//[^'")\s]+)}.freeze

LEGAL_PAGES = {
  # slug => strings the built page must contain
  'imprint' => ['Schulte development', '5 DDG'],
  'privacy' => ['Verantwortlicher', 'DSGVO']
}.freeze

task :test do
  failures = []
  failures.concat(no_external_subresources)
  failures.concat(css_assets_resolve)
  failures.concat(legal_pages_present_and_linked)
  failures.concat(homepage_checks)
  failures.concat(company_pages_have_portfolio_entry)
  report(failures)
  puts '✅ Custom checks passed'

  options = {
    :ignore_urls => [
      /http:\/\/localhost:4000\/.*/,
      /https:\/\/outlook\.office365\.com\/.*/,
      /https:\/\/.*linkedin\.com\/.*/,
      /https:\/\/stackoverflow\.com\/.*/
    ],
    :disable_external => false
  }

  HTMLProofer.check_directory('./_site', options).run
  puts '✅ All tests passed'
end

# Separate task so CI can also run it on the production build.
desc 'Assert the built site loads nothing from a third party'
task :no_external do
  report(no_external_subresources + css_assets_resolve)
  puts '✅ No external sub-resources'
end

def report(failures)
  return if failures.empty?

  raise "#{failures.size} check(s) failed:\n  - #{failures.join("\n  - ")}"
end

# An external sub-resource sends the visitor's IP to a third party before any consent.
def no_external_subresources
  offenders = []

  Dir.glob('./_site/**/*.html').sort.each do |path|
    doc = Nokogiri::HTML(File.read(path))

    doc.css('link[href]').each do |node|
      next unless (node['rel'].to_s.downcase.split & FETCHING_LINK_RELS).any?
      next unless node['href'] =~ EXTERNAL

      offenders << %(#{path}: <link rel="#{node['rel']}" href="#{node['href']}">)
    end

    SUBRESOURCE_ATTRS.each do |tag, attrs|
      doc.css(tag).each do |node|
        attrs.each do |attr|
          node[attr].to_s.split(/[\s,]+/).each do |candidate|
            offenders << %(#{path}: <#{tag} #{attr}="#{candidate}">) if candidate =~ EXTERNAL
          end
        end
      end
    end

    inline = doc.css('style').map(&:text) + doc.css('[style]').map { |n| n['style'] }
    inline.compact.each do |css|
      css.scan(CSS_REF).flatten.each { |ref| offenders << "#{path}: inline CSS #{ref}" }
    end
  end

  # html-proofer doesn't read CSS.
  Dir.glob('./_site/**/*.css').sort.each do |path|
    File.read(path).scan(CSS_REF).flatten.each { |ref| offenders << "#{path}: #{ref}" }
  end

  offenders.uniq.map { |o| "External sub-resource: #{o}" }
end

# Webfonts are referenced only from CSS url(), which html-proofer doesn't read.
def css_assets_resolve
  missing = []

  Dir.glob('./_site/**/*.css').sort.each do |css_path|
    File.read(css_path).scan(/url\(\s*['"]?([^'")]+)['"]?\s*\)/).flatten.each do |ref|
      next if ref.start_with?('data:') || ref =~ EXTERNAL

      target = ref.sub(/[?#].*\z/, '')
      resolved = if target.start_with?('/')
                   File.join('./_site', target)
                 else
                   File.expand_path(target, File.dirname(css_path))
                 end
      missing << "#{css_path} -> #{ref}" unless File.exist?(resolved)
    end
  end

  missing.map { |m| "CSS references a file missing from _site: #{m}" }
end

# Legal pages must be reachable from the home page, not just built.
def legal_pages_present_and_linked
  problems = []
  return ['index.html missing'] unless File.exist?('./_site/index.html')

  home = Nokogiri::HTML(File.read('./_site/index.html'))

  LEGAL_PAGES.each do |slug, markers|
    path = "./_site/#{slug}.html"
    unless File.exist?(path)
      problems << "#{slug}.html missing"
      next
    end

    text = Nokogiri::HTML(File.read(path)).text
    markers.each do |marker|
      problems << "#{slug}.html is missing #{marker.inspect}" unless text.include?(marker)
    end
    problems << "No link to /#{slug} on the home page" if home.css("a[href='/#{slug}']").empty?
  end

  problems
end

def homepage_checks
  return ['index.html missing'] unless File.exist?('./_site/index.html')

  home = Nokogiri::HTML(File.read('./_site/index.html'))
  h1 = home.at_css('h1')
  return ['No h1 found on the home page'] unless h1
  return ["Home page h1 does not start with 'Markus Schulte': #{h1.text.strip}"] unless
    h1.text.strip.start_with?('Markus Schulte')

  json_ld = home.at_css('script[type="application/ld+json"]')
  return ['No JSON-LD on the home page'] unless json_ld

  JSON.parse(json_ld.text)
  []
rescue JSON::ParserError => e
  ["Home page JSON-LD is not valid JSON: #{e.message}"]
end

# The company layout takes logo and period from _data/portfolio.yml by page URL.
def company_pages_have_portfolio_entry
  Dir.glob('./_site/companies/*.html').sort.filter_map do |path|
    period = Nokogiri::HTML(File.read(path)).at_css('.company-period')
    "#{path}: no matching entry in _data/portfolio.yml" if period.nil? || period.text.strip.empty?
  end
end
